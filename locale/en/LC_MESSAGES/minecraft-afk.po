#: scripts/stone-farm.sh:452
msgid ""
"Durabilidad máxima de picos vanilla (Java Edition):\n"
"\n"
"  Madera       59\n"
"  Piedra      131\n"
"  Hierro      250\n"
"  Oro          32\n"
"  Diamante   1561\n"
"  Netherita  2031\n"
"\n"
