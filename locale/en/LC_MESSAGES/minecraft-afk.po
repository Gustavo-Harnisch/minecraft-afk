#: scripts/minecraft-afk.sh:13
msgid ""
"Uso:\n"
"  minecraft-afk.sh start mob [opciones]\n"
"  minecraft-afk.sh start stone [opciones]\n"
"  minecraft-afk.sh stop\n"
"  minecraft-afk.sh emergency-stop\n"
"  minecraft-afk.sh status\n"
"  minecraft-afk.sh table"
msgstr "Usage:\n  minecraft-afk.sh start mob [options]\n  minecraft-afk.sh start stone [options]\n  minecraft-afk.sh stop\n  minecraft-afk.sh emergency-stop\n  minecraft-afk.sh status\n  minecraft-afk.sh table"

#: scripts/mob-farm.sh:14
